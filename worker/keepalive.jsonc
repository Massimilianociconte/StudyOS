{
  // Cron gratuito che impedisce la pausa del progetto Supabase Free (vedi supabase/keepalive.sql).
  // URL e chiave publishable sono secret del Worker: `npx wrangler secret put … -c worker/keepalive.jsonc`.
  "name": "studyos-supabase-keepalive",
  "main": "keepalive.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  // Una sola espressione (due giri al giorno): il piano Free ammette 5 cron per account.
  "triggers": {
    "crons": ["17 3,15 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
