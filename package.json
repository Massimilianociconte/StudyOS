{
  "name": "studyos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run icons && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc -b --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node --import ./scripts/lib/register-ts.mjs --test tests/*.test.mjs",
    "barb:sync": "node scripts/barb.mjs sync",
    "barb:sync:schedule": "node scripts/barb.mjs sync --scope schedule",
    "barb:sync:courses": "node scripts/barb.mjs sync --scope courses",
    "barb:sync:teachers": "node scripts/barb.mjs sync --scope teachers",
    "barb:sync:contacts": "node scripts/barb.mjs sync --scope contacts",
    "barb:check-updates": "node scripts/barb.mjs check-updates",
    "barb:apply": "node scripts/barb.mjs apply",
    "barb:status": "node scripts/barb.mjs status",
    "barb:validate": "node scripts/barb.mjs validate",
    "firecrawl:up": "node scripts/barb.mjs firecrawl-up",
    "firecrawl:health": "node scripts/barb.mjs firecrawl-health"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "date-fns": "latest",
    "dexie": "latest",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "postcss": "latest",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "latest",
    "vite": "latest"
  },
  "engines": {
    "node": ">=22.18"
  }
}
